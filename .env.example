# ClipNest configuration — copy this file to .env and adjust as needed.
# `docker compose` isse automatically load karta hai.

# ============================================================================
# Telegram bot (main setup)
# ============================================================================

# @BotFather -> /newbot se token lein. Bot chalane ke liye yeh zaroori hai.
# CLIPNEST_TELEGRAM_BOT_TOKEN=123456789:AAExampleToken

# Sirf in Telegram user IDs ko ijazat (comma separated). Khali = sab allowed.
# Apna ID bot mein /id bhej kar dekhein.
# CLIPNEST_TELEGRAM_ALLOWED_USERS=123456789,987654321

# Telegram par ek file ka max size (MB).
# Cloud Bot API ki hard limit 50 MB hai. Local Bot API server ke saath 2000 tak.
CLIPNEST_TELEGRAM_MAX_UPLOAD_MB=50

# Estimated size limit se badi ho to download shuru hi na karein? (true/false)
CLIPNEST_TELEGRAM_STRICT_SIZE=false

# Probe card mein max quality buttons (default 8).
CLIPNEST_TELEGRAM_QUALITY_LIMIT=8

# Video ke liye ffmpeg se thumbnail banayein? (preview ke liye achha)
CLIPNEST_TELEGRAM_GENERATE_THUMBNAIL=true

# Progress message kitne second mein update ho (Telegram flood limit ke liye 3-4 rakhein).
CLIPNEST_TELEGRAM_PROGRESS_INTERVAL_SECONDS=4

# Bade upload ke liye timeout (seconds).
CLIPNEST_TELEGRAM_UPLOAD_TIMEOUT_SECONDS=1800

# Buttons kitni der valid rahein (minutes).
CLIPNEST_TELEGRAM_PROBE_TTL_MINUTES=120

# Per-user settings aur probe buttons kahan save hon.
# CLIPNEST_TELEGRAM_USERS_FILE=./data/bot_users.json
# CLIPNEST_TELEGRAM_PROBES_FILE=./data/bot_probes.json

# ---- Local Bot API server (optional, 50 MB se badi files ke liye) ----
# https://github.com/tdlib/telegram-bot-api se apna server chalayein.
# Docker compose mein `--profile local-api` use karein.
# CLIPNEST_TELEGRAM_API_BASE_URL=http://telegram-bot-api:8081
# CLIPNEST_TELEGRAM_MAX_UPLOAD_MB=2000

# my.telegram.org se API credentials (sirf local Bot API server ke liye).
# TELEGRAM_API_ID=1234567
# TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# ---- Webhook mode (optional, production ke liye) ----
# Khali chhodne par bot long polling use karta hai.
# CLIPNEST_TELEGRAM_WEBHOOK_URL=https://bot.example.com
# CLIPNEST_TELEGRAM_WEBHOOK_SECRET=change-me-please
# CLIPNEST_TELEGRAM_WEBHOOK_LISTEN=0.0.0.0
# CLIPNEST_TELEGRAM_WEBHOOK_PORT=8080

# ============================================================================
# Download engine
# ============================================================================

# Kitne downloads ek saath chalenge
CLIPNEST_MAX_CONCURRENT_DOWNLOADS=2

# Download files kitne minute tak rakhe jaayein
CLIPNEST_JOB_TTL_MINUTES=60

# Ek file ka maximum size (MB)
CLIPNEST_MAX_FILESIZE_MB=2048

# Maximum video length (seconds). 10800 = 3 ghante
CLIPNEST_MAX_DURATION_SECONDS=10800

# Netscape format cookies file (private/age-restricted content ke liye)
# CLIPNEST_COOKIES_FILE=./data/cookies.txt

# Private/loopback addresses allow karein? Sirf local testing ke liye true karein.
CLIPNEST_ALLOW_PRIVATE_HOSTS=false

# Rate limit: har IP / Telegram user se 10 minute mein kitne requests
CLIPNEST_RATE_LIMIT_PER_10MIN=20
